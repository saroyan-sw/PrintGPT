# Copy to .env (ignored by Git) and fill in. Never commit real addresses or secrets.
PRINTGPT_GMAIL_ACCOUNT=<recipient Gmail address>
PRINTGPT_SCAN_SENDER=<scanner sender Gmail address>
PRINTGPT_GMAIL_CREDENTIALS_PATH=<absolute path to OAuth desktop-client JSON>
# Optional; defaults to %LOCALAPPDATA%\PrintGPT\gmail_token.json
# PRINTGPT_GMAIL_TOKEN_PATH=<absolute path to locally stored OAuth token>
# Optional filters and limits
# PRINTGPT_SCAN_SUBJECT_FILTER=PrintGPT Scan
# PRINTGPT_SCAN_LOOKBACK_DAYS=7
# PRINTGPT_SCAN_MAX_ATTACHMENT_MB=50
# PRINTGPT_SCAN_POLL_INTERVAL_S=4
# PRINTGPT_SCAN_TIMEOUT_S=180
# Live Gemini generation (optional; the offline demo needs none of this).
# Paid: each run makes up to 4 image + 4 critic requests. Never commit a real key.
# GEMINI_API_KEY=<your Gemini API key>
